# ---- Runtime
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# ---- Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/taskforge?schema=public"

# ---- Auth (change in production; generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10
COOKIE_SECURE=false

# ---- Uploads (local disk driver in dev; swap for S3 in prod)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Email (console driver when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskForge <no-reply@taskforge.local>"
